{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StageLight",
  "version": "../package.json",
  "identifier": "org.salvation.stagelight",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": "node scripts/fetch-node.mjs && node scripts/build-io.mjs --dev",
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/build-io.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Entertainment",
    "shortDescription": "Lighting desk, 3D stage preview and show control",
    "externalBin": ["binaries/node", "binaries/stagelight-io"],
    "resources": {
      "../engine/": "app/engine/",
      "../public/": "app/public/",
      "../mcp/": "app/mcp/",
      "../server.mjs": "app/server.mjs",
      "../package.json": "app/package.json",
      "../data/show.json": "app/show-template.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNzg5NTlENTkzM0JBMTcKUldRWHVqTlpuWlY0T3ptRVRZNHdCQzRQMENIUDR3NklOQlRZQWFSRVQrY05sVHd2TTR4REwyenkK",
      "endpoints": ["https://github.com/crownemmanuel/stagelight/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
