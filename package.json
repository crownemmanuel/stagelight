{
  "name": "stagelight",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "StageLight: an independently runnable lighting engine, operator desk, 3D stage preview, and MCP server.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "tauri": "tauri",
    "fetch:node": "node scripts/fetch-node.mjs",
    "release": "node scripts/release.mjs",
    "build:installer": "tauri build --config src-tauri/tauri.unsigned.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
